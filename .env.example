# Application settings
APP_NAME=Events Aggregator
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/events_aggregator

# Events Provider API
EVENTS_PROVIDER_BASE_URL=http://events-provider.dev-2.python-labs.ru
EVENTS_PROVIDER_API_KEY=your_api_key_here

# Background sync
SYNC_INTERVAL_MINUTES=1440

# Outbox worker
OUTBOX_POLL_INTERVAL_SECONDS=5
OUTBOX_BATCH_SIZE=10
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BACKOFF_BASE_SECONDS=2
OUTBOX_BACKOFF_MAX_SECONDS=300
OUTBOX_BACKOFF_JITTER_RATIO=0.2

# Notification service (Capashino)
CAPASHINO_BASE_URL=http://student-system-capashino-web.student-system-capashino.svc:8000
CAPASHINO_API_KEY=your_capashino_api_key_here
CAPASHINO_TIMEOUT_SECONDS=10

# Idempotency keys
IDEMPOTENCY_KEY_TTL_HOURS=168

# GlitchTip (Sentry-compatible error tracking)
# DSN выдаётся после одобрения запроса на интеграцию и повторного provisioning
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
